    int pos=1;
    while (*str!='\0')
    {
        p=str;
        q=sub;
        while (*p==*q && *q!='\0')
        {
            p++;
            q++;
        }
        if (*q=='\0')
        {
            printf("%d", pos);
            return;
        }
        str++;
        pos++;
    }
    printf("Not Found");
}
